# GovSkill Backend — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
PROJECT_NAME="GovSkill"
API_V1_STR="/api"

# ---------------------------------------------------------------------------
# Security — JWT
# Generate a strong random secret key, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The value MUST NOT be left as a placeholder — the backend will reject it.
# ---------------------------------------------------------------------------
SECRET_KEY=your-secret-key-here
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Security — Digital Credential Signing
# Generate a separate strong random signing key for HMAC-SHA256 certificates:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The value MUST NOT be left as a placeholder or match SECRET_KEY.
# ---------------------------------------------------------------------------
CREDENTIAL_SIGNING_KEY=your-credential-signing-key-here

# ---------------------------------------------------------------------------
# Database
# Default development value uses SQLite (no external DB required).
# For production, replace with a PostgreSQL connection string:
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/govskill
# ---------------------------------------------------------------------------
DATABASE_URL="sqlite+aiosqlite:///./govskill.db"

# ---------------------------------------------------------------------------
# Google Gemini AI
# Required for the AI Tutor and GovAssist plain-language explanations.
# Obtain a key at: https://aistudio.google.com/app/apikey
# Leave empty to run without AI features (tutor/explain endpoints will fail).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=25.0
AI_MAX_CONCURRENCY=5
AI_VISION_ENABLED=true

# ---------------------------------------------------------------------------
# CORS — Allowed Origins
# Comma-separated list of frontend origins permitted to call the API.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# ---------------------------------------------------------------------------
# Authentication — Bootstrap and Email
# ---------------------------------------------------------------------------
# Set to the first admin's email. Only used once — the first admin creation.
# After the first admin exists, this is ignored. Remove it in production.
BOOTSTRAP_ADMIN_EMAIL=

# Frontend URL for admin invite links.
FRONTEND_URL=http://localhost:5173

# Email transport for OTP and invite delivery. Use 'console' in dev.
# For production: set to 'smtp' and configure the SMTP_* values below.
EMAIL_TRANSPORT=console

# SMTP — required only when EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=