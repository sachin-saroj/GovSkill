# ===========================================================================
# GovSkill — Full-Stack Docker Compose Environment Variables
# ===========================================================================
# Copy this file to .env before starting with: docker compose up -d
# NEVER commit .env files containing production secrets to source control.

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=govskill_user
# REQUIRED: No default provided. Set a secure database password before running docker compose.
POSTGRES_PASSWORD=
POSTGRES_DB=govskill

# --- Security / JWT Configuration ---
# REQUIRED: No default provided. Must be explicitly set (min 32 chars).
# Generate a strong 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# REQUIRED: No default provided. Must be explicitly set (min 32 chars).
# Used for HMAC-SHA256 digital certificate signing and verification.
CREDENTIAL_SIGNING_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Initial Administrator Credentials ---
ADMIN_EMAIL=admin@govskill.local
# REQUIRED: No default provided. Set a secure password for the initial admin account.
ADMIN_PASSWORD=

# --- Google Gemini AI API Key ---
# Required for AI Tutor and plain-language validation explanations
# Leave empty to run with deterministic fallback explanations
GEMINI_API_KEY=
